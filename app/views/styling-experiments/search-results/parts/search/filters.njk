{% set filterOptionsHtml %}
  {{ govukCheckboxes({
    name: "orgType",
    classes: "govuk-checkboxes--small",
    fieldset: {
      legend: {
        text: "Type of organisation",
        classes: "govuk-fieldset__legend--s"
      }
    },
    items: [
      {
        value: "trust",
        text: "Trust"
      },
      {
        value: "school",
        text: "School, including academy"
      }
    ]
  }) }}

  {{ govukCheckboxes({
    name: "status",
    classes: "govuk-checkboxes--small",
    fieldset: {
      legend: {
        text: "Status",
        classes: "govuk-fieldset__legend--s"
      }
    },
    items: [
      {
        value: "open",
        text: "Open"
      },
      {
        value: "closed",
        text: "Closed"
      }
    ]
  }) }}

  {{ govukCheckboxes({
    name: "phase",
    classes: "govuk-checkboxes--small",
    fieldset: {
      legend: {
        text: "Phase of education",
        classes: "govuk-fieldset__legend--s"
      }
    },
    items: [
      {
        value: "primary",
        text: "Primary"
      },
      {
        value: "secondary",
        text: "Secondary"
      },
      {
        value: "16-to-19",
        text: "16 to 19"
      },
      {
        value: "not-applicable",
        text: "Not applicable"
      }
    ]
  }) }}
{% endset %}

{{ mojFilter({
  heading: {
    text: "Filter"
  },
  submit: {
    text: "Apply filters"
  },
  optionsHtml: filterOptionsHtml
}) }}
