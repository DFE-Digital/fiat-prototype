<h2 class="govuk-heading-l">Other tools and products (links open in a new tab)</h2>

{# Set up the macro by including the recurring bits for each item. HTMl may be easier than Nunjucks here. #}
{% macro signpostItem(title="'title'", description="'description'") %} 

<div class="dfe-card">
    <div class="dfe-card-container">
    <h3 class="govuk-heading-m">
        <a href="#" class="govuk-link govuk-link--no-visited-state dfe-card-link--header">{{title}}</a>
    </h3>
    <p>{{description}}</p>
    </div>
</div>

{% endmacro %}

<div class="dfe-grid-container">
    {{signpostItem(title="Local Authority Interactive Tool (LAIT)​", description="Tool to provide an overall view of an authority and its trends.")}}
    {{signpostItem(title="Attainment Tool with Latest Available Schools Time-series (ATLAST)", description="Provides a time series of school level attainment key headline measures for phonics, KS2, KS4 and KS5. ")}}
    {{signpostItem(title="Explore Education Statistics (EES)​", description="Tool to provide provides official statistics, downloadable files and the ability to create tables, suitable for those who need to continue into a more detailed analysis​.")}}
    {{signpostItem(title="Financial Benchmarking and Insights Tool (FBIT)​", description="Tool for viewing and comparing financial information at school, trust and local-authority level.")}}
    {{signpostItem(title="Association of Directors of Children’s Services (ACDS)", description="Tool for finding for finding Directors and Assistant Directors of Children's Services")}}
    {{signpostItem(title="Data tools", description="Approved data tools, datasets, and guidance produced by the Data Analysis Unit (DAU).")}}
</div>