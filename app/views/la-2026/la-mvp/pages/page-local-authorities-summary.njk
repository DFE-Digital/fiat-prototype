{% extends "/la-2026/la-mvp/layouts/la_layout.njk" %}

{% set pageTitle = "Leeds city council" %}
{% set pageHeading = pageTitle %}

{% set primNavActive = "home" %}

{# Set an active state on the appropraite primary nav item #}
{% set navActive = "overview" %}

{# Set an active state on the appropraite secondary nav item #}
{% set subPageHeading = "Local authority details" %}
{% set subNavActive = "la-summary" %}

{# Set an appropriate page caption #}
{% set pageCaption = "Local authority" %}

{# Custom block for the main content area of a trust page #}
{% block laContent %}

  <h2 class="govuk-heading-l">
      Overview
  </h2>

  {# Sub-nav to flick through data sets #}
  {% include "../parts/overview-sub_nav.njk" %}

  <h3 class="govuk-heading-m">Local authority summary</h3>

  {# Tabs to flick through tables #}
  {# {% include "../parts/local-authorities-tabs.njk" %} #}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {# Details list #}
      {% include "../lists/list-summary.njk" %}

    </div>
  </div>

  {# {{ govukButton({
    text: "Download all academy data",
    classes: "govuk-button--secondary",
    href: "#"
  }) }} #}

  <hr class="govuk-section-break govuk-section-break--m">

  {# Sources and updates #}
  {% include "/la-2026/la-mvp/parts/sourcesUpdates.njk" %}

{% endblock %}

