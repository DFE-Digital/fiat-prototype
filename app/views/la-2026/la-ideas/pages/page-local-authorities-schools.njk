{% extends "/la-2026/la-ideas/layouts/la_layout.njk" %}

{% set pageTitle = "Leeds city council" %}
{% set pageHeading = pageTitle %}

{% set primNavActive = "home" %}

{# Set an active state on the appropraite primary nav item #}
{% set navActive = "schools" %}

{# Set an appropriate page caption #}
{% set pageCaption = "Local authority" %}

{# Custom block for the main content area of an LA page #}
{% block laContent %}

  <h2 class="govuk-heading-l">
      Schools the LA supports
  </h2>

  {# Tabs to flick through tables (from small-iterations-current/232167-notification-banner) #}
  {% include "/la-2026/la-ideas/parts/schools-tabs.njk" %}

  {{ govukButton({
    text: "Download all school data",
    classes: "govuk-button--secondary",
    href: "#"
  }) }}

  <hr class="govuk-section-break govuk-section-break--m">

  {# Sources and updates #}
  {% include "/la-2026/la-mvp/parts/sourcesUpdates.njk" %}

{% endblock %}
