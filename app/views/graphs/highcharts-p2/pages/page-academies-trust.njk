{% extends "graphs/highcharts-p2/layouts/trust_layout.njk" %}

{% set pageTitle = "Abbey Academies Trust" %}
{% set pageHeading = pageTitle %}

{# Set an active state on the appropraite primary nav item #}
{% set navActive = "academies" %}

{# Set an active state on the appropraite secondary nav item #}
{% set subPageHeading = "In this trust" %}
{% set subNavActive = "in-trust" %}

{# Custom block for the main content area of a trust page #}
{% block trustContent %}

  <h2 class="govuk-heading-l">
      Academies
  </h2>

  {# Sub-nav to flick through data sets #}
  {% include "../parts/sub_nav.njk" %}

  <h3 class="govuk-heading-m">In this trust</h3>

  {# Tabs to flick through tables #}
  {% include "../parts/academies-tabs.njk" %}

  {{ govukButton({
    text: "Download all academy data",
    classes: "govuk-button--secondary",
    href: "#"
  }) }}

  {# Sources and updates #}
  {% include "/trust-academies/205668-date-joined/parts/sourcesUpdates.njk" %}

{% endblock %}

